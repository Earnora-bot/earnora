
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "earnora-app",
  "main": "src/index.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "earnora-db",
      "database_id": "PASTE_YOUR_DATABASE_ID_HERE"
    }
  ]
}
